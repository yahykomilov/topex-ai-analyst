# ==== Скопируй этот файл в .env и заполни своими значениями ====

# Telegram
TELEGRAM_BOT_TOKEN=
# доступ к боту помимо владельца: Telegram chat_id через запятую (пусто = только владелец)
EXTRA_OWNER_IDS=

# --- Модель анализа. Приоритет: OpenAI (основная) > Groq (бесплатный fallback) > Claude (не активен) ---

# OpenAI (основная модель анализа)
OPENAI_API_KEY=
ANALYSIS_MODEL=gpt-4o-mini

# Anthropic Claude — зарезервировано, не активно (нужен оплаченный ключ)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Groq (бесплатный fallback на лимиты OpenAI: анализ + расшифровка)
GROQ_API_KEY=
GROQ_API_KEY_2=                                       # запасной аккаунт (rate-limit fallback)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile

# Gemini — ОСНОВНОЙ транскрибер для узбекского (слушает аудио, различает говорящих)
GEMINI_API_KEY=
# у free-tier gemini-2.0-flash часто квота 0 → рабочий бесплатный это 2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# amoCRM (поддомен из адреса кабинета XXX.amocrm.ru + долгосрочный токен)
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=

# Язык расшифровки аудио (uz/ru/en...); пусто = автоопределение.
# uz → узбекский идёт через Gemini (точнее + разделение говорящих). Для Topex: uz
WHISPER_LANGUAGE=

# Белый список операторов через запятую (пусто = все)
MANAGER_WHITELIST=

# Пропускать звонки короче N секунд
MIN_CALL_DURATION=20
# Как часто опрашивать amoCRM, сек
POLL_INTERVAL=120
