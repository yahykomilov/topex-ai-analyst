# ==== Скопируй этот файл в .env и заполни своими значениями ====

# Telegram
TELEGRAM_BOT_TOKEN=

# --- Модель анализа. Приоритет: Claude > Groq (бесплатно) > OpenAI ---

# OpenAI (платно)
OPENAI_API_KEY=
ANALYSIS_MODEL=gpt-4o-mini

# Anthropic Claude (самый качественный анализ)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Groq (бесплатный тариф: расшифровка + анализ)
GROQ_API_KEY=
GROQ_API_KEY_2=                                       # запасной аккаунт (rate-limit fallback)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile

# Gemini (запасной транскрибер для узбекского, когда Whisper не справляется)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# amoCRM (поддомен из адреса кабинета XXX.amocrm.ru + долгосрочный токен)
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=

# Язык расшифровки аудио (uz/ru/en...); пусто = автоопределение
WHISPER_LANGUAGE=

# Белый список операторов через запятую (пусто = все)
MANAGER_WHITELIST=

# Пропускать звонки короче N секунд
MIN_CALL_DURATION=20
# Как часто опрашивать amoCRM, сек
POLL_INTERVAL=120
